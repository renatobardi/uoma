# Copie para .env e preencha.
TARGET_URL=http://100.66.254.24:8081/
TARGET_USER=
TARGET_PASS=

# Modelo roda no HOST (não no container). host.docker.internal = teu Mac.
MODEL_BASE_URL=http://host.docker.internal:8080/v1
MODEL_NAME=ui-tars-1.5-7b

# Como o UI-TARS expressa coordenada. Calibrar no smoke test:
#   norm1000 = 0..1000 normalizado (default) | absolute = pixels da imagem
COORD_SPACE=norm1000

# Objetivo da exploração (opcional).
UOMA_TASK=Explore a aplicação e percorra os principais fluxos de usuário.
